# Cloudflare credentials & scope for cloudflare_api_manager.rb
#
# Copy to /etc/fail2ban/cloudflare.env and lock it down:
#     sudo install -m 0600 -o root -g root cloudflare.env.example /etc/fail2ban/cloudflare.env
#     sudo editor /etc/fail2ban/cloudflare.env
#
# The script auto-loads this path (override with CLOUDFLARE_ENV_FILE).
# Real environment variables, if set, take precedence over this file.

# --- Preferred: scoped API token (Authorization: Bearer) ---
# Create at https://dash.cloudflare.com/profile/api-tokens
# Permission: Zone > Firewall Services > Edit  (restricted to the zone below).
CLOUDFLARE_API_TOKEN=your_api_token_here

# Zone to apply blocks to (least-privilege, recommended scope).
# Zone ID is on the zone's Overview page in the dashboard.
CLOUDFLARE_ZONE_ID=your_zone_id_here

# --- Alternative scope (used only if CLOUDFLARE_ZONE_ID is unset) ---
# Blocks account-wide across all zones. Token needs
# Account > Firewall Access Rules > Edit.
#CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# --- Legacy fallback (used only if CLOUDFLARE_API_TOKEN is unset) ---
# The global API key grants full account access — prefer a token above.
#CLOUDFLARE_EMAIL=you@example.com
#CLOUDFLARE_API_KEY=your_global_api_key_here
